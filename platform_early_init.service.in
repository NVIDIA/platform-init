[Unit]
Description=Bring up the platform hardware before sysinit
DefaultDependencies=no
Conflicts=shutdown.target
After=systemd-tmpfiles-setup-dev.service
Before=shutdown.target sysinit.target time-set.target platform_init.service
Wants=time-set.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/platform init @PLATFORM_NAME@-early
SyslogIdentifier=platform-init
TimeoutStartSec=300

[Install]
WantedBy=sysinit.target
