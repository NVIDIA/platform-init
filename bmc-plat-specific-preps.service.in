[Unit]
Description=Platform specific changes in filesystem
DefaultDependencies=no
After=local-fs.target
Before=basic.target
Before=systemd-udevd.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/platform init @PLATFORM_NAME@-preps
SyslogIdentifier=nvidia_plat_specific_preps
RemainAfterExit=no

[Install]
WantedBy=basic.target
